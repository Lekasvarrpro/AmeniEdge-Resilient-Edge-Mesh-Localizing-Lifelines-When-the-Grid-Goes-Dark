# AmeniEdge Environment Variables Template
# Server Port & Active Profile
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# PostGIS / PostgreSQL Configuration
POSTGRES_DB=amenedge
POSTGRES_USER=amenedge
POSTGRES_PASSWORD=amenedge
DB_PORT=5432

# Spring Boot Datasource
DB_URL=jdbc:postgresql://localhost:5432/amenedge
DB_USER=amenedge
DB_PASSWORD=amenedge
DB_DRIVER=org.postgresql.Driver
FLYWAY_ENABLED=true

# Security Secrets
JWT_SECRET=ameniedge_default_development_jwt_secret_key_needs_to_be_at_least_32_bytes_long!
STATION_SHARED_HMAC_KEY=ameniedge_mesh_hmac_shared_secret_2026


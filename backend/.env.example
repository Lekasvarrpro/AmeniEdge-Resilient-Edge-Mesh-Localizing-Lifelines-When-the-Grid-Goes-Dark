# AmeniEdge Backend Environment Configuration
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL with PostGIS)
DB_URL=jdbc:postgresql://localhost:5432/amenedge
DB_USER=amenedge
DB_PASSWORD=amenedge
DB_DRIVER=org.postgresql.Driver
FLYWAY_ENABLED=true

# Station Node Identity
AMENIEDGE_STATION_ID=STA-CHN-N-001

# Security & Secrets
JWT_SECRET=ameniedge_default_development_jwt_secret_key_needs_to_be_at_least_32_bytes_long!
STATION_SHARED_HMAC_KEY=ameniedge_mesh_hmac_shared_secret_2026
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173


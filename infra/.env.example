# AmeniEdge Environment Configuration Template

# Operational Profile: 'dev', 'station-edge', or 'central-regional'
SPRING_PROFILES_ACTIVE=station-edge

# Station Node Identity
STATION_ID=STA-CHN-N-001
STATION_NAME="Station North Command"
REGION_ID=REG-CHN-01

# Server Port
SERVER_PORT=8080

# Database Credentials
DB_URL=jdbc:postgresql://localhost:5432/ameniedge_station
DB_USER=ameniedge
DB_PASSWORD=ameniedge_offline_secret

# Cryptographic Keys (At least 256 bits HMAC-SHA256)
JWT_SECRET=ameniedge_station_north_mesh_hmac_sha256_secret_key_minimum_32_bytes_long_offline
STATION_SHARED_HMAC_KEY=ameniedge_inter_station_mesh_sync_hmac_sha256_shared_auth_key_2026

# Map & Tile Cache Settings
OFFLINE_TILES_PATH=/usr/share/nginx/tiles
DEFAULT_MAP_LAT=13.0827
DEFAULT_MAP_LNG=80.2707
DEFAULT_MAP_ZOOM=14
